{
  "name": "video-flotante",
  "version": "0.1.0",
  "private": true,
  "description": "Extensión de navegador para ver videos HTML5 en una ventana flotante (Picture-in-Picture). Safari primero, Chrome después.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/build.ts --target=chrome --watch",
    "dev:safari": "node scripts/build.ts --target=safari --watch",
    "build": "npm run build:safari && npm run build:chrome",
    "build:safari": "node scripts/build.ts --target=safari",
    "build:chrome": "node scripts/build.ts --target=chrome",
    "package:chrome": "npm run build:chrome && node scripts/package-chrome.ts",
    "safari:xcode": "npm run build:safari && node scripts/safari-xcode.ts --build",
    "icons": "node scripts/generate-icons.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build.ts --target=chrome --e2e && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test:safari-webdriver": "node scripts/safari-webdriver-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
